# ==============================================================================
# COLLEGE DOCUMENT ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate the real values.
# NEVER commit your production .env with real secrets to public repositories!

# ------------------------------------------------------------------------------
# 1. DATABASE & VECTOR STORE (Supabase Free Tier)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL from Supabase Project Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Project API URL (Found in Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (Used for public client-side interactions)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (Used strictly on backend for admin storage operations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Storage Bucket Name in Supabase Storage for uploaded PDFs
SUPABASE_BUCKET_NAME=college-docs

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI API (Free Tier from Google AI Studio)
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiFreeApiKeyHere
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate a secure 32-byte secret key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=e4f8b9d3c2a1059f7e8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. PREDEFINED SYSTEM ADMINISTRATOR ACCOUNT
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=AdminSecurePass2026!

# ------------------------------------------------------------------------------
# 5. CORS & DEPLOYMENT ORIGINS
# ------------------------------------------------------------------------------
# Local development: http://localhost:5173
# Production: https://your-app-name.vercel.app
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 6. FINE-TUNED INTENT CLASSIFIER SETTINGS
# ------------------------------------------------------------------------------
# Optional: Hugging Face Model Repository ID if you push your LoRA adapter to HF Hub
HUGGINGFACE_REPO_ID=
# Toggle fallback mode: Set to "true" to force lightweight rule-based classifier (saves RAM)
USE_FALLBACK_CLASSIFIER=false
